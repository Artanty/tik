# tik back — full env reference
# Local dev: cp .env.example .env and adjust. Prod: serf writes the deployed .env
# from safe rows + pipeline values — nothing here is read on the box directly.

# ── app ──────────────────────────────────────────────────────────────────────

# port to listen on (unique per VDS service; tik = 3202 in safe)
PORT=3202

# path prefix all routes live under (safe row '/tik' in prod; unset = root locally)
API_PREFIX=

# auth gate: 'false' skips Bearer + x-web-host-url on /sse and the events-state
# routes (SSE pool = URL :poolId; collect/update need body.poolId in body).
# AGREED OFF ('false') for the FIRST deploy (owner, 2026-11-22) — flip to 'true'
# after base functions are verified. 'true'/unset = full token gate (SPEC §6).
AUTH_ENABLED=true

# this service's ecosystem identity (X-Project-Id to key@, tick-log prefix)
PROJECT_ID=tik@back

# ── key@back token broker ────────────────────────────────────────────────────

# where BASE_KEY is exchanged for scoped cross-service tokens.
# LOCALLY: key@ on :3041. PROD: arrives automatically — flow passes key_back_url
# as a serf input and serf writes it into the deployed .env; NO safe row needed.
KEY_BACK_URL=http://localhost:3041

# long registration key from key@ POST /register for (PROJECT_ID, public url).
# Rotates on every re-register — keep in lockstep or /get-token 403s
# ("base key rotten"). In prod this is a safe row (stage DEPLOY).
BASE_KEY=

# ── outer events (doro) ──────────────────────────────────────────────────────

# where finished events are reported (/service/set-event-state).
# DEFERRED for the first deploy (owner, 2026-11-22): no safe row yet, so prod
# runs with the localhost default and the finish-flow fails+retries (err_0
# markers) until this gets its deployed value.
OUTER_EVENTS_BACK_URL=http://localhost:3201
OUTER_EVENTS_PROJECT_ID=doro@back

