# port to listen on (serf VDS deploys expect a unique PORT per service)
PORT=3202

# temporary dev gate-off: 'false' skips Bearer + x-web-host-url on /sse and the
# events-state routes (SSE pool = URL :poolId; collect/update need body.poolId).
# keep 'true' (or unset) anywhere except local runs — flip back before deploying
AUTH_ENABLED=true

# path prefix all routes live under (safe row '/tik' in prod; unset = root, local)
API_PREFIX=

# this service's identity in the ecosystem
PROJECT_ID=tik@back

# key@back token broker: exchanges BASE_KEY for scoped cross-service tokens
KEY_BACK_URL=http://localhost:3041

# long registration key issued by key@back POST /register for (PROJECT_ID, deployed url)
# rotates on every re-register — keep in sync with what key@back stores
BASE_KEY=

# outer events service the tick loop reports finished events to (was hardcoded in the node build)
OUTER_EVENTS_BACK_URL=http://localhost:3201
OUTER_EVENTS_PROJECT_ID=doro@back

# optional, debug response props only
PROJECT_NAME=
NAMESPACE=
